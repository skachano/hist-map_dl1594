{
  "additionalProperties": false,
  "description": "Tenure of a place: generated from `entries` (Stage 4).",
  "properties": {
    "source_page": {
      "anyOf": [
        {
          "pattern": "^\\d{1,3}(?:-\\d{1,3})?(?:;\\s*\\d{1,3}(?:-\\d{1,3})?)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Page"
    },
    "confidence": {
      "default": "high",
      "title": "Confidence",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "place_id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Place Id",
      "type": "string"
    },
    "tenure": {
      "title": "Tenure",
      "enum": [
        "domain",
        "fief",
        "clergy",
        "safeguard"
      ]
    },
    "holder_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holder Id"
    },
    "share": {
      "anyOf": [
        {
          "pattern": "^(?:\\d+/\\d+|part|joint)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Share"
    },
    "share_with": {
      "items": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Share With",
      "type": "array"
    },
    "via_entry": {
      "items": {
        "pattern": "^(?:[1-9]\\d{0,3}|x-\\d{1,3}-\\d{1,2})$",
        "type": "string"
      },
      "title": "Via Entry",
      "type": "array"
    }
  },
  "required": [
    "place_id",
    "tenure"
  ],
  "title": "holdings",
  "type": "object"
}
