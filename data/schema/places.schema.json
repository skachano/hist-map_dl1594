{
  "additionalProperties": false,
  "properties": {
    "source_page": {
      "anyOf": [
        {
          "pattern": "^\\d{1,3}(?:-\\d{1,3})?(?:;\\s*\\d{1,3}(?:-\\d{1,3})?)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Page"
    },
    "confidence": {
      "default": "high",
      "title": "Confidence",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "settlement",
        "territory"
      ],
      "title": "Kind",
      "type": "string"
    },
    "name_fr": {
      "title": "Name Fr",
      "type": "string"
    },
    "name_de": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name De"
    },
    "name_en": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name En"
    },
    "variants": {
      "items": {
        "type": "string"
      },
      "title": "Variants",
      "type": "array"
    },
    "old_forms": {
      "items": {
        "type": "string"
      },
      "title": "Old Forms",
      "type": "array"
    },
    "place_type": {
      "title": "Place Type",
      "enum": [
        "town",
        "small_town",
        "village",
        "hamlet",
        "farmstead",
        "grange",
        "castle",
        "pleasure_house",
        "palace",
        "abbey",
        "priory",
        "convent",
        "collegiate_church",
        "cathedral",
        "commandery",
        "charterhouse",
        "hospital",
        "glassworks",
        "saltworks",
        "mill",
        "mine",
        "mint",
        "arsenal",
        "market",
        "passage",
        "deserted_village",
        "duchy",
        "bailiwick",
        "provostship",
        "sub_provostship",
        "castellany",
        "office",
        "receivership",
        "landschultheisserei",
        "ban",
        "mayoralty",
        "val",
        "town_district",
        "district",
        "county",
        "marquisate",
        "barony",
        "lordship",
        "fief",
        "allod",
        "temporality"
      ]
    },
    "lat": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lat"
    },
    "lon": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lon"
    },
    "wikidata_id": {
      "anyOf": [
        {
          "pattern": "^Q\\d+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wikidata Id"
    },
    "geonames_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geonames Id"
    },
    "modern_country": {
      "anyOf": [
        {
          "enum": [
            "FR",
            "DE",
            "LU"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modern Country"
    },
    "index_kind": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Kind"
    },
    "index_commune": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Commune"
    },
    "index_canton": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Canton"
    },
    "index_dept": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Dept"
    },
    "lost": {
      "default": false,
      "title": "Lost",
      "type": "boolean"
    },
    "geo_method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geo Method"
    },
    "geo_confidence": {
      "anyOf": [
        {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geo Confidence"
    },
    "hierarchy": {
      "anyOf": [
        {
          "enum": [
            "admin",
            "feudal"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hierarchy"
    },
    "holder_id": {
      "items": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Holder Id",
      "type": "array"
    },
    "counterpart_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Counterpart Id"
    },
    "counterpart_basis": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "heading",
            "slot",
            "alix_list",
            "rule"
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Counterpart Basis"
    }
  },
  "required": [
    "id",
    "kind",
    "name_fr",
    "place_type"
  ],
  "title": "places",
  "type": "object"
}
